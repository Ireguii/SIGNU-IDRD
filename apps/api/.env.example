PORT=3100
HOST=0.0.0.0
# The administrative panel always binds to 127.0.0.1.
DASHBOARD_PORT=3101
# Public ArcGIS layer + local fallback. Use snapshot for an offline demo.
GEO_PROVIDER=public
# Optional Docker PostgreSQL/PostGIS. By default uses persistent PGlite + PostGIS.
# DATABASE_URL=postgresql://signu:signu-local-only@127.0.0.1:5434/signu
# Additional origin for browser access over your Wi-Fi. Use your PC IP and Expo port.
# WEB_ORIGINS=http://192.168.1.25:8081
